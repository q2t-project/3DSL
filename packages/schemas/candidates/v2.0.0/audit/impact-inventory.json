{
  "audit_version": "p0-v1",
  "audit_date": "2026-10-30",
  "method": "Static source and call-site review; not browser proof or a claim of candidate runtime support. No implementation files changed.",
  "candidate_status": "Candidate schema only; current readers/writers remain on existing contracts.",
  "checks_required_before_p3": [
    "Select known schema by declared URI/version before pruning/normalization.",
    "Keep old valid/invalid fixtures and old non-power-of-two values unchanged.",
    "Assert candidate attributes roundtrip through actual Modeler save/reopen rather than only JSON serialization.",
    "Measure post-font-load bounds/pick/fit in active Troika, Canvas fallback and Modeler preview.",
    "Distinguish transient emphasis, geometry scaling, raster supersampling and authored label-size hierarchy."
  ],
