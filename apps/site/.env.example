# AdSense (manual display ads)
#
# 1) Create two ad units in AdSense:
#    - 300x250 (for mobile/inline)
#    - 300x600 (for desktop rail)
#
# 2) Paste each "data-ad-slot" value below.
#
# NOTE: In Astro, ONLY variables prefixed with PUBLIC_ are exposed to the client.

PUBLIC_ADSENSE_SLOT_300x250="REPLACE_WITH_YOUR_300x250_SLOT_ID"
PUBLIC_ADSENSE_SLOT_300x600="REPLACE_WITH_YOUR_300x600_SLOT_ID"

# Set true only when site approval, AdSense settings and consent handling are ready.
PUBLIC_ADSENSE_SERVING_ENABLED=false
# Optional fixed 300x250 unit for the academic atlas. Falls back to SLOT_300x250.
PUBLIC_ADSENSE_SLOT_GUIDED_READER=""
