---
import AdSlot from "./AdSlot.astro";
import { ACADEMIC_ATLAS_READER } from "../lib/academicAtlas";
import { shouldEnableAdsense } from "../lib/adsense";

interface Props {
  title: string;
  adSlot?: string;
  expanded?: boolean;
}
const { title, adSlot = "", expanded = false } = Astro.props;
const showAd = shouldEnableAdsense(Astro.url.pathname) && Boolean(adSlot);
---

<section id="atlas-model" aria-labelledby="academic-atlas-intro">
  <div class="atlas-intro">
    <h2 id="academic-atlas-intro">学問のあいだで、何が渡るのか</h2>
    <p>物理の法則は機械の設計に使われ、工学が整えた測定は物理の研究に戻ってきます。図の関係を一つ選び、渡る知見と受け手の問いをたどってみてください。</p>
  </div>
  <div class:list={["atlas-stage", { "atlas-stage--expanded": expanded }]}>
    <iframe
      class="academic-atlas-model"
      src={ACADEMIC_ATLAS_READER}
      title={title + " 読解ガイド"}
      sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
      data-swipe-ignore
    />
    <div class="atlas-interpretation">
      <p data-academic-atlas-interpretation>重力波研究では、検出器の出力を較正して得たひずみの時系列から、信号の有無や発生源の性質を調べます。人文地理学では、統計と地図を共通の地域コードで結ぶと、人口や人口密度の分布を地域ごとに比べられます。図の矢印は、このように何を受け取ればどんな問いを扱えるかを示します。</p>
      <p class="atlas-sources">
        出典
        <cite><a class="site-link" href="https://doi.org/10.1103/PhysRevD.95.062003">Advanced LIGOの較正論文</a></cite>
        ／ <cite><a class="site-link" href="https://www.e-stat.go.jp/gis">e-Stat 統計地理情報システム</a></cite>
      </p>
    </div>
    {showAd && (
      <aside data-academic-atlas-ad aria-label="広告">
        <p data-academic-atlas-ad-label>広告</p>
        <AdSlot slot={adSlot} width={300} height={250} waitForLibrary={true} />
      </aside>
    )}
  </div>
</section>

<style>
  #atlas-model { margin-block-start: 1.25rem; scroll-margin-top: 7rem; min-width: 0; }
  .atlas-intro, .atlas-interpretation { max-width: 77ch; }
  .atlas-intro { margin-block-end: 1.25rem; }
  .atlas-intro h2 { margin-block: 0 .5rem; color: var(--ui-text); }
  .atlas-intro p, [data-academic-atlas-interpretation] { line-height: 1.75; font-family: var(--font-reading, "Noto Serif JP", serif); }
  .atlas-intro p { margin-block: .5rem; }
  .atlas-sources { margin-block: .45rem 0; font-family: var(--font-ui); font-size: .8125rem; }
  .atlas-sources cite { font-style: normal; }
  .academic-atlas-model {
    display: block;
    width: 100%;
    min-width: 0;
    height: clamp(26rem, 78svh, 53rem);
    border: 1px solid var(--ui-border-2);
    border-radius: .75rem;
  }
  .atlas-stage--expanded .academic-atlas-model { height: clamp(28rem, 85svh, 60rem); }
  .atlas-interpretation { margin-block: .95rem 0; }
  [data-academic-atlas-interpretation] { margin: 0; }
  [data-academic-atlas-ad] { --ad-label-space: 1.375rem; margin-inline: auto; width: min(100%, 300px); }
  [data-academic-atlas-ad-label] { display: none; margin: 0 0 .375rem; color: var(--ui-muted); font: .8125rem/1rem var(--font-ui); }
  [data-academic-atlas-ad]:has(:global([data-3dsl-ad-reserved])):not(:has(:global(ins.adsbygoogle[data-ad-status="unfilled"]))) {
    min-height: 17.5rem;
    margin-block: 3rem;
    padding-block-start: .5rem;
  }
  [data-academic-atlas-ad]:has(:global(ins.adsbygoogle[data-ad-status="filled"])) [data-academic-atlas-ad-label] {
    display: block;
  }
  [data-academic-atlas-ad]:has(:global([data-3dsl-ad-reserved])):not(:has(:global(ins.adsbygoogle[data-ad-status="filled"]))) :global(.ad-slot) {
    padding-top: var(--ad-label-space);
  }
  [data-academic-atlas-ad]:has(:global(ins.adsbygoogle[data-ad-status="unfilled"])) { display: none; }
  [data-academic-atlas-ad] :global(ins.adsbygoogle[data-ad-status="unfilled"]) { display: none !important; }
  @media (max-width: 315px) { [data-academic-atlas-ad] { display: none; } }
  @media (min-width: 1240px) {
    .atlas-stage:has(:global([data-3dsl-ad-reserved])):not(:has(:global(ins.adsbygoogle[data-ad-status="unfilled"]))) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      column-gap: 3.5rem;
    }
    .academic-atlas-model, .atlas-interpretation { grid-column: 1; }
    [data-academic-atlas-ad]:has(:global([data-3dsl-ad-reserved])) {
      grid-area: 1 / 2;
      align-self: center;
    }
  }
</style>
