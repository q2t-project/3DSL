---
import { readFileSync } from "node:fs";
import { publicDir } from "astro:config/server";

// A lightweight projection of the opening frame. Cards never start WebGL.
interface Props { model: string }
interface Point { meta: { uuid: string }; appearance: { position?: number[]; frames?: number[]; marker?: { common?: { color?: string }; text?: { content?: string; size?: number } } } }
interface Line { appearance: { end_a?: { ref?: string }; end_b?: { ref?: string }; color?: string; frames?: number[] } }
const input = JSON.parse(readFileSync(new URL(Astro.props.model.slice(1), publicDir), "utf8"));
const scene = input.scene ?? input;
const visible = (item: { appearance: { frames?: number[] } }) => !item.appearance.frames?.length || item.appearance.frames.includes(0);
const points = (scene.points as Point[] ?? []).filter(visible).flatMap(({ appearance, meta }) => {
  if (!appearance.position) return [];
  const [x,y,z] = appearance.position;
  return [{ id: meta.uuid, x: (y-x)*0.866, y: (x+y)*0.5-z, marker: appearance.marker }];
});
const xs = points.map(p => p.x), ys = points.map(p => p.y);
const left = Math.min(...xs), top = Math.min(...ys);
const width = Math.max(...xs)-left, height = Math.max(...ys)-top;
const scale = Math.min(270/Math.max(1,width), 112/Math.max(1,height));
const projected = points.map(p => ({ ...p, x: 160+(p.x-left-width/2)*scale, y: 76+(p.y-top-height/2)*scale }));
const byId = new Map(projected.map(p => [p.id,p]));
const links = (scene.lines as Line[] ?? []).filter(visible).flatMap(({appearance}) => {
  const a = byId.get(appearance.end_a?.ref ?? ""), b = byId.get(appearance.end_b?.ref ?? "");
  return a && b ? [{a,b,color:appearance.color}] : [];
});
const labels = projected.filter(p => typeof p.marker?.text?.content === "string")
  .sort((a,b) => (b.marker?.text?.size ?? 0)-(a.marker?.text?.size ?? 0)).slice(0,3);
---
<svg viewBox="0 0 320 152" aria-hidden="true" focusable="false" style="width:100%;background:#10151c;border-radius:.5rem">
  {links.map(({a,b,color}) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke={color ?? "#9caec0"} opacity=".68" />)}
  {projected.map(p => <circle cx={p.x} cy={p.y} r="2.5" fill={p.marker?.common?.color ?? "#c1daec"} />)}
  {labels.map(p => <text x={Math.min(225,Math.max(5,p.x+4))} y={Math.max(12,p.y-5)} fill="#f4f5f6" stroke="#10151c" stroke-width="2" paint-order="stroke" font-size="10">{p.marker?.text?.content}</text>)}
</svg>
