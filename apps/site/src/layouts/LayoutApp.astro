---
import "../styles/global.css";

const { title = "3DSL" } = Astro.props;
---

<!doctype html>
<html lang="ja" class="h-full overflow-hidden">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: enable safe-area env() on iOS notch devices -->
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <!-- Standalone application screens do not load advertising code. -->
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..600&display=swap"
    />
    <title>{title}</title>
    <slot name="head" />

    <style>
      :root{
        --font-sans: Inter, system-ui, -apple-system, "Segoe UI",
          "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
      }
      body{ font-family: var(--font-sans); }
      html, body {
        height: 100%;
        width: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
      }
      body.app-shell {
        position: fixed;
        inset: 0;
        overflow: hidden;
        overscroll-behavior: none;
      }
    </style>

	    <!-- Critical app-shell invariants (do not rely on utility CSS being present) -->
	    <style is:global>
	      html, body { height: 100%; margin: 0; }
	      body { overflow: hidden; }
	    </style>
  </head>

  <!-- app screen: fixed viewport, no page scroll -->
  <body class="h-full h-[100dvh] overflow-hidden text-neutral-100 antialiased app-shell">
    <slot />
  </body>
</html>
