---
import Layout from "../layouts/Layout.astro";
import AtlasStage from "../components/AtlasStage.astro";
import WorkPreview from "../components/WorkPreview.astro";
import { getLibraryItems } from "../lib/libraryIndex";

const works = getLibraryItems().filter(item => !item.hidden && item.model_url);
const featured = works.filter(item => item.recommended).sort((a,b) =>
  Number(b.tags?.includes("m:top") ?? false) - Number(a.tags?.includes("m:top") ?? false) || a.id.localeCompare(b.id)
)[0] ?? works[0];
const viewer = (model: string) => "/app/viewer/?" + new URLSearchParams({ model, return: "/" });
const knowledge = { title: "知識と問い", model: "/preview-reconstruction/models/knowledge_questions.3dsl-work.json", detail: "/docs/works/knowledge-questions/" };
const lead = featured ? { title: featured.title, model: featured.model_url!, detail: `/library/${featured.slug}/` } : knowledge;
const others = [
  { title: knowledge.title, model: knowledge.model, primary: viewer(knowledge.model), secondary: knowledge.detail, secondaryLabel: "作品の解説" },
  ...works.map(item => ({
    title: item.title, model: item.model_url!, primary: `/library/${item.slug}/`,
    secondary: viewer(item.model_url!), secondaryLabel: "Viewerで大きく開く",
  })),
].filter(work => work.model !== lead.model);
---
<Layout title="3DSLアトラス" description="概念と関係を三次元で見渡せる作品集。モデルを回し、気になる部分に近づいて、そのつながりをたどれます。">
  <section aria-labelledby="feature">
    <header class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h1 class="site-atlas-name">3DSLアトラス</h1>
      <p class="text-sm leading-relaxed"><span class="inline-block">知識のつながりを描いた立体地図です。</span><span class="inline-block">全体を見渡し、気になる点からたどれます。</span></p>
    </header>
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
      <h2 id="feature" class="site-feature-title">{lead.title}</h2>
      <a class="underline" data-atlas-expand={lead.model} href={viewer(lead.model)}>Viewerで大きく開く ↗</a>
    </div>
    <AtlasStage model={lead.model} title={lead.title} />
    <div class="mt-2 flex flex-wrap items-baseline justify-between gap-2 text-sm">
      <span>ドラッグで回転 · ピンチまたはホイールで拡大</span>
      <a class="underline" href={lead.detail}>作品ページへ</a>
    </div>
  </section>
  <section class="mt-8" aria-labelledby="works">
    <div class="flex items-baseline justify-between mb-3"><h2 id="works" class="text-xl font-semibold">ほかの作品</h2><a class="underline" href="/library">作品一覧へ</a></div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {others.slice(0,3).map(work => <article>
        <a class="block" href={work.primary}><WorkPreview model={work.model}/><h3 class="site-work-title mt-2">{work.title}</h3></a>
        <a class="text-sm underline" href={work.secondary}>{work.secondaryLabel}</a>
      </article>)}
    </div>
  </section>
  <details class="mt-8 border-t border-neutral-700 py-4"><summary class="cursor-pointer">3DSLについて・使い方</summary>
    <nav class="mt-3 flex flex-wrap gap-4"><a class="site-link" href="/concept">3DSLの狙い</a><a class="site-link" href="/docs/works/knowledge-questions/">知識と問いの読み方</a><a class="site-link" href="/docs/usage/first-work">はじめての制作</a><a class="site-link" href="/preview-reconstruction/">作る・開く</a><a class="site-link" href="/docs">使い方</a></nav>
  </details>
</Layout>
