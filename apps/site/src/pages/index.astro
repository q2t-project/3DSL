---
import Layout from "../layouts/Layout.astro";
import WorkPreview from "../components/WorkPreview.astro";
import { getLibraryItems } from "../lib/libraryIndex";

const works = getLibraryItems().filter(item => !item.hidden && item.model_url);
const featured = works.filter(item => item.recommended).sort((a,b) =>
  Number(b.tags?.includes("m:top") ?? false) - Number(a.tags?.includes("m:top") ?? false) || a.id.localeCompare(b.id)
)[0] ?? works[0];
const knowledge = { title: "知識と問い", model: "/preview-reconstruction/models/knowledge_questions.3dsl-work.json", detail: "/docs/works/knowledge-questions/" };
const lead = featured ? { title: featured.title, model: featured.model_url!, detail: `/library/${featured.slug}/` } : knowledge;
const others = [knowledge, ...works.map(item => ({title:item.title, model:item.model_url!, detail:`/library/${item.slug}/`}))].filter(work => work.model !== lead.model);
const viewer = (model:string) => "/app/viewer/?" + new URLSearchParams({model, return:"/"});
---
<Layout title="3DSL — モデルを見る" description="概念と関係を三次元で見渡せる作品集。モデルを回し、気になる部分に近づいて、そのつながりをたどれます。">
  <section aria-labelledby="feature">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
      <h1 id="feature" class="text-2xl font-semibold">{lead.title}</h1>
      <a class="underline" href={viewer(lead.model)}>Viewerで大きく開く ↗</a>
    </div>
    <iframe class="stage" src={`/viewer/peek.html?model=${encodeURIComponent(lead.model)}`} title={`${lead.title}の操作画面`} allow="fullscreen"></iframe>
    <div class="mt-2 flex flex-wrap items-baseline justify-between gap-2 text-sm">
      <span>ドラッグで回転 · ピンチまたはホイールで拡大</span>
      <a class="underline" href={lead.detail}>この作品の解説</a>
    </div>
  </section>
  <section class="mt-8" aria-labelledby="works">
    <div class="flex items-baseline justify-between mb-3"><h2 id="works" class="text-xl font-semibold">ほかの作品</h2><a class="underline" href="/library">作品一覧へ</a></div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {others.slice(0,3).map(work => <article>
        <a class="block" href={viewer(work.model)}><WorkPreview model={work.model}/><h3 class="mt-2 font-semibold">{work.title}</h3></a>
        <a class="text-sm underline" href={work.detail}>解説</a>
      </article>)}
    </div>
  </section>
  <details class="mt-8 border-t border-neutral-700 py-4"><summary class="cursor-pointer">3DSLについて・使い方</summary>
    <nav class="mt-3 flex flex-wrap gap-4 underline"><a href="/concept">3DSLの狙い</a><a href="/docs/works/knowledge-questions/">知識と問いの読み方</a><a href="/docs/usage/first-work">はじめての制作</a><a href="/preview-reconstruction/">作る・開く</a><a href="/docs">使い方</a></nav>
  </details>
</Layout>
<style>
.stage { display:block; width:100%; height:clamp(16rem,55svh,38rem); background:#10151c; border:1px solid #454b53; border-radius:.75rem; }
</style>
