---
import Layout from "../layouts/Layout.astro";
import TopText from "../content/pages/top.md";

import fs from "node:fs/promises";

// Featured examples
// The Library index is generated by `npm run sync:3dss-content`.
type LibraryIndexItem = {
  id: string;
  title: string;
  summary?: string | null;
  tags?: string[] | null;
  hidden?: boolean;
  recommended?: boolean;
};

const libraryIndexUrl = new URL("../../public/_data/library/library_index.json", import.meta.url);

let featuredItems: LibraryIndexItem[] = [];
try {
  const raw = await fs.readFile(libraryIndexUrl, "utf8");
  const parsed = JSON.parse(raw);
  const items = Array.isArray(parsed?.items) ? (parsed.items as LibraryIndexItem[]) : [];
  // Editorial choices live in _meta.json. Do not fill vacant slots with fixtures.
  featuredItems = items
    .filter((item) => !item.hidden && item.recommended === true)
    .sort((a, b) =>
      Number(b.tags?.includes("m:top") ?? false) - Number(a.tags?.includes("m:top") ?? false) || a.id.localeCompare(b.id)
    )
    .slice(0, 3);
} catch {
  featuredItems = [];
}

const entrances = [
  { title: "3DSLの狙い", href: "/concept", text: "配置と接続によって、何を表し、何を確かめようとしているのか。" },
  { title: "作品を見る", href: "/library", text: "作品の解説を読み、Viewerで視点を動かして構造を見る。" },
  { title: "作る・開く", href: "/preview-reconstruction/", text: "Modelerで作る・続きを開く。保存した作品をViewerで読む。" },
  { title: "使い方", href: "/docs", text: "読み方、制作、保存と再開、ファイル形式を調べる。" },
];
---

<Layout
  title="3DSL — 関係を配置し、構造を見渡す"
  description="3DSLは、概念や対象を三次元空間に配置し、関係を表し、考えるための試みです。作品を読み、Modelerで作り、Viewerで見渡せます。"
>
  <section class="grid gap-6 lg:grid-cols-3">
    <div class="ui-surface p-6 sm:p-8 lg:col-span-2">
      <div class="prose prose-invert prose-neutral max-w-none font-content hero-copy">
        <TopText />
      </div>
    </div>
    <aside class="ui-surface p-6 sm:p-8 flex flex-col justify-center">
      <p class="text-xs tracking-widest text-neutral-400">はじめての方へ</p>
      <h2 class="mt-3 text-xl font-semibold">一つの問いから、図を読む</h2>
      <p class="mt-3 text-sm text-neutral-300 leading-7">
        「知識と問い」の解説から始めます。説明を手がかりに図を開き、気になる項目とそのつながりを確かめてください。
      </p>
      <a class="ui-btn mt-5 inline-flex justify-center" href="/docs/works/knowledge-questions">「知識と問い」を読む</a>
    </aside>
  </section>

  <section class="mt-10" aria-labelledby="home-entrances">
    <h2 id="home-entrances" class="text-lg font-semibold">目的から選ぶ</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {entrances.map((entry) => (
        <a href={entry.href} class="ui-card block p-6">
          <h3 class="text-lg font-semibold">{entry.title}</h3>
          <p class="mt-3 text-sm text-neutral-300 leading-7">{entry.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="ui-surface mt-10 p-6 sm:p-8" aria-labelledby="home-reading">
    <h2 id="home-reading" class="text-xl font-semibold">解説と図を行き来する</h2>
    <p class="mt-3 text-sm text-neutral-300 leading-7 max-w-3xl">
      何を整理した図かを確かめ、配置や接続を辿り、説明へ戻る。作品ごとの読み方を用意しています。
    </p>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <a class="ui-card block p-5" href="/docs/works/knowledge-questions">
        <h3 class="font-semibold">知識と問い</h3>
        <p class="mt-2 text-sm text-neutral-300 leading-7">問いと、それに関わる知識や回答を、図と情報欄から辿ります。</p>
      </a>
      <a class="ui-card block p-5" href="/docs/works/structure-classification">
        <h3 class="font-semibold">構造と分類</h3>
        <p class="mt-2 text-sm text-neutral-300 leading-7">線の接続ではなく、概念を置いた位置やまとまりを手がかりに読む例です。</p>
      </a>
    </div>
    <p class="mt-5 text-sm text-neutral-400">
      操作や読み方に迷ったら、<a class="underline underline-offset-4 hover:text-neutral-200" href="/docs/usage/read-a-work">作品を読むための案内</a>へ。
    </p>
  </section>

  <section class="ui-surface mt-10 p-6 sm:p-8" aria-labelledby="home-works">
    <h2 id="home-works" class="text-xl font-semibold">公開作品から</h2>
    <p class="mt-3 text-sm text-neutral-300 leading-7 max-w-3xl">
      制作時点の考え方を表した作品です。各ページの解説と図をあわせてご覧ください。
    </p>
    <div class:list={["mt-5 grid gap-4", featuredItems.length >= 3 ? "lg:grid-cols-3" : "md:grid-cols-2"]}>
      {featuredItems.map((item) => (
        <a href={`/library/${item.id}`} class="ui-card block p-5">
          <h3 class="font-semibold">{item.title}</h3>
          {item.summary && <p class="mt-2 text-sm text-neutral-300 leading-7">{item.summary}</p>}
          <p class="mt-4 text-sm text-neutral-400">作品のページへ →</p>
        </a>
      ))}
    </div>
    <div class="mt-6">
      <a class="ui-btn inline-flex" href="/library">作品一覧を見る</a>
    </div>
  </section>

  <section class="mt-10 grid gap-4 lg:grid-cols-2" aria-label="3DSLの現在地">
    <div class="ui-surface p-6 sm:p-8">
      <h2 class="text-xl font-semibold">研究していること</h2>
      <p class="mt-3 text-sm text-neutral-300 leading-7">
        対象の捉え方、関係、軸と配置の意味を、異なる事例で検討しています。公開作品には制作時点の試案も含まれ、読み直しや更新を続けています。
      </p>
      <a class="mt-4 inline-block text-sm underline underline-offset-4 hover:text-neutral-200" href="/concept">3DSLの狙いを読む</a>
    </div>
    <div class="ui-surface p-6 sm:p-8">
      <h2 class="text-xl font-semibold">アプリでできること</h2>
      <p class="mt-3 text-sm text-neutral-300 leading-7">
        対応する作品を閲覧し、点や関係を編集し、作品一式を端末へ保存して再開できます。読み込める形式と保存される内容は、使い方で確認できます。
      </p>
      <a class="mt-4 inline-block text-sm underline underline-offset-4 hover:text-neutral-200" href="/docs/usage/create-save-read">制作と保存の案内を読む</a>
      <p class="mt-3 text-sm"><a class="underline underline-offset-4 hover:text-neutral-200" href="/docs/usage/first-work">一つの問いから、最初の小作品を作る</a></p>
    </div>
  </section>
</Layout>
