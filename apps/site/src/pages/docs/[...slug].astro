---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const pageTitle = `${entry.data?.title ?? entry.id} | Docs | 3DSL`;
const pageDescription = typeof entry.data?.summary === "string" && entry.data.summary.trim()
  ? entry.data.summary.trim()
  : "3DSL Docs（SSOT: packages/docs）";
---

<Layout title={pageTitle} description={pageDescription}>
  <nav class="text-sm text-neutral-400">
    <a href="/docs" class="hover:underline">Docs</a>
    <span class="mx-2">/</span>
    <span class="text-neutral-200">{entry.id}</span>
  </nav>

  <article class="mt-6 prose prose-invert prose-neutral max-w-3xl">
    <Content />
  </article>
</Layout>

<style>
  nav, article { min-width: 0; overflow-wrap: anywhere; }
  @media (max-width: 40rem) {
    article :global(table) { table-layout: fixed; width: 100%; }
  }
</style>
