---
import Layout from '../../../layouts/Layout.astro';
import { cases, checks, connections, originPoints, historyLinks, modelPath, viewerPath, isReviewPreview } from '../../../lib/conceptRepair.mjs';

export function getStaticPaths() {
  return isReviewPreview() ? [{ params: { page: undefined } }] : [];
}
const descriptions = {
  current: '公開中の内容と同じ。ルートの点がなく、3本の線に参照先の欠落があります。',
  concept: '名称と表示を Concept に戻します。履歴の文字サイズ8を保ち、文字の向きだけを現行形式に対応させました。',
  tophello: '削除直前の点を戻します。名称は Concept、表示は topHello 3DSL、文字サイズ64です。見え方の比較用です。',
};
const x = (position: number[]) => 320 + position[0] * 9;
const y = (position: number[]) => 168 - position[1] * 7;
---

<Layout title="Concept の復元比較 | 3DSL" description="欠落したルート1点の復元意図と表示を確かめる比較ページ。" adsenseEligible={false}>
  <Fragment slot="head"><meta name="robots" content="noindex, nofollow" /></Fragment>
  <article class="review">
    <header>
      <p class="eyebrow">作者確認用 · Preview</p>
      <h1>Concept のルートを戻すか、表示を比べる</h1>
      <p>同じ1点を参照する3本の線が、接続先を失っています。履歴に残る点を、同じ UUID・同じ原点に戻す2案を用意しました。<strong>公開中の作品と推薦設定は変更していません。</strong></p>
      <p>推奨候補は <strong>Concept 表示</strong>です。全体のルートという名称・制作メモと表示が一致し、文字サイズも削除直前の64から履歴の8へ戻せます。ただし、履歴だけで削除が事故だったとは判断していません。</p>
    </header>

    <section aria-labelledby="compare-heading">
      <h2 id="compare-heading">同じ Viewer で3ケースを比べる</h2>
      <p>まず現行を開き、次に Concept、最後に topHello を確認してください。Viewer 左上の「戻る」でこのページへ戻れます。視点や拡大率は各ケースでそろえて比べてください。</p>
      <div class="cases">
        {cases.map((entry, index) => (
          <section class:list={['case', { preferred: entry.id === 'concept' }]}>
            <p class="eyebrow">{index + 1} / {entry.id === 'concept' ? '推奨候補・未採用' : '比較用'}</p>
            <h3>{entry.label}</h3>
            <p>{descriptions[entry.id as keyof typeof descriptions]}</p>
            <p class="counts">{checks[index].points} 点 · {checks[index].lines} 本 · 欠落参照 {checks[index].missing}</p>
            <a class="open" href={viewerPath(entry.id, entry.label)}>Viewer で確認する →</a>
            <a class="json" href={modelPath(entry.id)} download={`concept-repair-${entry.id}.3dss.json`}>比較データを保存</a>
          </section>
        ))}
      </div>
    </section>

    <section aria-labelledby="connections-heading">
      <h2 id="connections-heading">復元する1点と3本の接続</h2>
      <p>復元点の名称は Concept、位置は [0, 0, 0]。3本はいずれも、この点から各節へ向かう包含関係です。線の参照先や、既存38点・41本の内容と配置は変えていません。</p>
      <figure>
        <svg class="diagram" viewBox="0 0 640 370" role="img" aria-labelledby="diagram-title diagram-desc">
          <title id="diagram-title">Concept の原点と3接続の XY 投影</title>
          <desc id="diagram-desc">復元点から、表現の限界と要請、新しい表現の実験、宣言に接続する。原点には別の既存2点も重なっている。対象点はすべて Z 座標0。</desc>
          <defs><marker id="connection-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#7dd3fc" /></marker></defs>
          <path d="M40 168H600 M320 28V346" stroke="#475569" stroke-dasharray="3 6" />
          <text x="600" y="155" class="axis">X+</text><text x="333" y="35" class="axis">Y+</text>
          {connections.map(({ target }) => (
            <g>
              <line x1="320" y1="168" x2={x(target.appearance.position)} y2={y(target.appearance.position)} stroke="#7dd3fc" stroke-width="2" marker-end="url(#connection-arrow)" />
              <circle cx={x(target.appearance.position)} cy={y(target.appearance.position)} r="6" fill="#7dd3fc" />
              <text x={x(target.appearance.position)} y={y(target.appearance.position) + (target.appearance.position[1] < 0 ? 28 : -22)} text-anchor="middle">{target.signification.name}</text>
              <text x={x(target.appearance.position)} y={y(target.appearance.position) + (target.appearance.position[1] < 0 ? 46 : -5)} text-anchor="middle" class="coordinate">[{target.appearance.position.join(', ')}]</text>
            </g>
          ))}
          <rect x="308" y="156" width="24" height="24" fill="none" stroke="#fbbf24" stroke-width="2" />
          <rect x="311" y="159" width="18" height="18" fill="none" stroke="#fbbf24" stroke-dasharray="2 2" />
          <circle cx="320" cy="168" r="6" fill="#7dd3fc" />
          <text x="342" y="187">Concept [0, 0, 0]</text>
          <text x="342" y="207" class="coordinate">既存2点も同じ位置</text>
        </svg>
        <figcaption>位置・接続データから作成した補助図（XY 投影、対象点の Z はすべて0）。水色は復元点と接続、黄色は原点にある既存2点を示します。記号と文字は説明のために配置しており、形や文字サイズを再現していません。<strong>3D実描画の代替ではありません。</strong></figcaption>
      </figure>
      <div class="table-scroll">
        <table>
          <caption>同じ原点にある点</caption>
          <thead><tr><th scope="col">点</th><th scope="col">表示・大きさ</th><th scope="col">扱い</th></tr></thead>
          <tbody>
            <tr><th scope="row">Concept（復元）</th><td>球の半径0.6。文字サイズ8 / 比較案64</td><td>候補に1点追加</td></tr>
            {originPoints.map((point) => <tr><th scope="row">{point.signification.name || '名称・表示文字なし'}</th><td>箱 [{point.appearance.marker.size.join(', ')}]、文字サイズ {point.appearance.marker.text.size}</td><td>現行のまま</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>箱と球、文字が同じ位置にあるため、隠れや重なりを Viewer で確認する必要があります。他の点を動かして解消する変更は、この候補には含めていません。</p>
    </section>

    <section aria-labelledby="decision-heading">
      <h2 id="decision-heading">確認してほしいこと</h2>
      <ol>
        <li><strong>意図：</strong>Concept を全体のルートとして戻し、3つの節につなぐ構成でよいか。</li>
        <li><strong>表示：</strong>Concept・サイズ8で読めるか。topHello・サイズ64との違いと、原点の重なりを確認する。</li>
        <li><strong>全体：</strong>対象3本をたどれるか、全体へ戻って他の点や線が読めるか。</li>
      </ol>
      <p>このページでの採用操作はありません。採用する案と、重なりに支障があるかを知らせてください。表示調整が必要なら、その変更を別に比較します。</p>
    </section>

    <section class="evidence" aria-labelledby="evidence-heading">
      <h2 id="evidence-heading">履歴と検査の範囲</h2>
      <p>2026年1月12日の点は Concept・サイズ8。削除直前は topHello 3DSL・サイズ64でした。1月20日の削除で点だけがなくなり、3本の線が残っています。今回戻すのは1点だけで、作品全体を過去へ巻き戻すものではありません。</p>
      <p>Concept 案では旧 <code>plane: zx</code> を現在の <code>pose: front [0,1,0], up [0,0,1]</code> へ対応させました。サイズ8は履歴上の数値を保っています。過去と現在の描画方式による見た目の同一性は保証していません。</p>
      <ul>
        <li>3ケースとも現行の正式 Schema に適合、UUID重複0。</li>
        <li>復元2案は39点・41本、欠落参照0。現行ケースの欠落3件は比較のため保持。</li>
        <li>復元点以外の38点・41本・文書メタデータ・補助要素は現行と同一。</li>
        <li><strong>3D実描画と採用判断は未確認。</strong>上記はデータ検査の結果です。</li>
      </ul>
      <p class="history-links">{historyLinks.map((link, index) => <>{index > 0 && ' · '}<a href={link.href}>{link.label}</a></>)}</p>
    </section>
  </article>
</Layout>

<style>
  .review { max-width: 66rem; margin: 0 auto; color: #dbe4f0; line-height: 1.85; }
  h1, h2, h3 { color: #f8fafc; line-height: 1.45; font-weight: 650; }
  h1 { margin: .45rem 0 1.2rem; font-size: clamp(1.8rem, 4vw, 2.7rem); }
  h2 { font-size: 1.45rem; margin: 0 0 .8rem; }
  h3 { font-size: 1.1rem; margin: .4rem 0 .8rem; }
  p { margin: .75rem 0; }
  .review > section { margin-top: 3rem; }
  .eyebrow { color: #94a3b8; font-size: .8rem; letter-spacing: .08em; }
  .cases { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1.4rem; }
  .case { border: 1px solid #334155; border-radius: .8rem; padding: 1.2rem; display: flex; flex-direction: column; background: #0f172a; }
  .case.preferred { border-color: #38bdf8; background: #0c2637; }
  .case p { font-size: .9rem; }
  .counts { color: #a5f3fc; margin-top: auto; padding-top: 1rem; }
  a { color: #7dd3fc; text-underline-offset: .2em; }
  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid #7dd3fc; outline-offset: 4px; }
  .open { display: block; background: #e0f2fe; color: #0c2637; padding: .65rem; border-radius: .4rem; text-align: center; font-weight: 650; margin: .8rem 0; }
  .json { font-size: .85rem; text-align: center; }
  figure { border: 1px solid #334155; border-radius: .8rem; background: #0f172a; padding: 1rem; margin: 1.2rem 0; }
  .diagram { display: block; width: 100%; max-width: 48rem; margin: auto; }
  .diagram text { fill: #e2e8f0; font-size: 15px; }
  .diagram .coordinate, .diagram .axis { fill: #94a3b8; font-size: 12px; }
  figcaption { color: #94a3b8; font-size: .83rem; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  caption { text-align: left; font-weight: 650; margin-bottom: .5rem; }
  th, td { padding: .7rem; border-bottom: 1px solid #334155; text-align: left; }
  th { color: #f1f5f9; }
  ol, ul { padding-left: 1.5rem; }
  li { margin: .5rem 0; }
  .evidence { border-top: 1px solid #334155; padding-top: 2rem; }
  .history-links { font-size: .85rem; }
  code { font-size: .85em; overflow-wrap: anywhere; }
  @media (max-width: 760px) { .cases { grid-template-columns: 1fr; } .case { padding: 1rem; } }
</style>
