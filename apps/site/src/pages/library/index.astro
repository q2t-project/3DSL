---
import { getLibraryItems } from "../../lib/libraryIndex";
import Layout from "../../layouts/Layout.astro";

const reservedTags = new Set(["m:top", "m:default", "m:__"]);
function displayTag(raw: unknown) {
  const tag = String(raw ?? "").trim();
  if (!tag || reservedTags.has(tag)) return "";
  const match = tag.match(/^(s|m|x):(.+)$/);
  return match ? (match[1] === "m" ? match[2] : "") : tag;
}
function dateText(value: unknown) {
  const text = String(value ?? "");
  return /^\d{4}-\d{2}-\d{2}/.test(text) ? text.slice(0, 10) : "";
}
function publishedDate(item: any) {
  return dateText(item.republished_at) || dateText(item.published_at) || dateText(item.created_at);
}
function dateLabel(item: any) {
  return dateText(item.republished_at) ? "改訂" : dateText(item.published_at) ? "公開" : "作成";
}
function viewerHref(value: string) {
  const url = new URL(value, "https://3dsl.jp");
  url.searchParams.set("return", "/library/");
  return url.origin === "https://3dsl.jp" ? url.pathname + url.search : url.href;
}
// All public cards exist in the initial HTML. JavaScript only filters these nodes.
const items = getLibraryItems().filter((item) => !item.hidden).map((item) => ({
  ...item,
  displayTags: (item.tags ?? []).map(displayTag).filter(Boolean),
  date: publishedDate(item),
  dateLabel: dateLabel(item),
})).sort((a, b) => b.date.localeCompare(a.date) || a.id.localeCompare(b.id));
---
<Layout title="作品を読む・作る | Library | 3DSL" description="3DSLの作品を解説と図で読む入口。知識と問い、構造と分類、小作品の制作教材と、公開作品の一覧。">
  <section class="library-page">
    <h1>作品を読む・作る</h1>
    <p class="library-intro">概念や対象の関係を、解説と図を行き来して確かめる作品を掲載しています。配置や線の意味は、各作品の解説で確認してください。</p>
    <nav class="learning-paths" aria-label="初めての方へ">
      <a href="/docs/works/knowledge-questions/"><strong>読む：知識と問い</strong><span>同じ回答の違いを、活動と根拠まで辿って確かめます。</span></a>
      <a href="/docs/usage/first-work/"><strong>作る：はじめての一作品</strong><span>光速度の例を7つの要素に絞り、保存して読み直します。</span></a>
      <a href="/docs/works/structure-classification/"><strong>比べる：構造と分類</strong><span>線のない配置から読めることと、決められないことを分けます。</span></a>
    </nav>
    <p class="library-note">制作教材は「知識と問い」と同じ光速度の題材を使っています。以下はLibraryに登録された作品です。</p>
    <h2>公開作品</h2>
    <div id="library-controls" class="library-controls" hidden>
      <label>作品を探す<input id="search" type="search" placeholder="作品名・説明・タグ" aria-controls="cards" /></label>
      <label>並べ替え<select id="sort" aria-controls="cards"><option value="new">新しい順</option><option value="old">古い順</option><option value="title">名前順</option></select></label>
    </div>
    <section id="cards" class="reading-grid" aria-label="作品一覧">
      {items.map((item) => (
        <article class="reading-card" data-library-id={item.id} data-title={item.title} data-date={item.date} data-search={[item.title, item.summary ?? "", ...item.displayTags].join(" ").toLowerCase()}>
          <div class="reading-meta"><span>作品ID：{item.id}</span>{item.date && <span>{item.dateLabel}：{item.date}</span>}</div>
          <h3><a href={typeof item.page === "string" ? item.page : `/library/${item.slug}/`}>{item.title}</a></h3>
          {item.summary && <p class="reading-summary">{item.summary}</p>}
          {item.displayTags.length > 0 && <p class="reading-tags">{item.displayTags.slice(0, 8).join(" ／ ")}{item.displayTags.length > 8 ? " …" : ""}</p>}
          <div class="reading-links">
            <a href={typeof item.page === "string" ? item.page : `/library/${item.slug}/`}>作品の説明を読む</a>
            {item.viewer_url && <a class="reading-viewer" href={viewerHref(item.viewer_url)}>従来版Viewerで開く</a>}
          </div>
        </article>
      ))}
    </section>
    {items.length === 0 && <p>現在、一覧に掲載する作品はありません。上の読解・制作教材から始められます。</p>}
    <p id="library-empty" role="status" hidden>一致する作品がありません。検索語を変えてください。</p>
    <nav id="library-pager" class="library-pager" aria-label="作品一覧のページ" hidden>
      <button id="prev" type="button">前へ</button><span id="page-info" role="status" aria-live="polite"></span><button id="next" type="button">次へ</button>
    </nav>
    <noscript><p>作品一覧はJavaScriptなしでも読めます。検索・並べ替え・ページ送りはJavaScriptを有効にすると利用できます。</p></noscript>
  </section>
  <script is:inline>
    (() => {
      const grid = document.getElementById("cards");
      const controls = document.getElementById("library-controls");
      const pager = document.getElementById("library-pager");
      const search = document.getElementById("search");
      const sort = document.getElementById("sort");
      const previous = document.getElementById("prev");
      const next = document.getElementById("next");
      const info = document.getElementById("page-info");
      const empty = document.getElementById("library-empty");
      if (!grid || !controls || !pager || !search || !sort || !previous || !next || !info || !empty) return;
      const cards = Array.from(grid.querySelectorAll("[data-library-id]"));
      const pageSize = 20;
      let page = 1;
      function apply() {
        const query = search.value.trim().toLowerCase();
        const selected = cards.filter((card) => card.dataset.search.includes(query));
        selected.sort((a, b) => {
          if (sort.value === "title") return a.dataset.title.localeCompare(b.dataset.title, "ja");
          const byDate = a.dataset.date.localeCompare(b.dataset.date);
          return (sort.value === "old" ? byDate : -byDate) || a.dataset.libraryId.localeCompare(b.dataset.libraryId);
        });
        const pages = Math.max(1, Math.ceil(selected.length / pageSize));
        page = Math.max(1, Math.min(page, pages));
        for (const card of cards) card.hidden = true;
        for (const card of selected) grid.appendChild(card);
        for (const card of selected.slice((page - 1) * pageSize, page * pageSize)) card.hidden = false;
        info.textContent = `${selected.length}作品・${page} / ${pages}ページ`;
        empty.hidden = selected.length !== 0;
        previous.disabled = page <= 1;
        next.disabled = page >= pages;
      }
      search.addEventListener("input", () => { page = 1; apply(); });
      sort.addEventListener("change", () => { page = 1; apply(); });
      previous.addEventListener("click", () => { page--; apply(); });
      next.addEventListener("click", () => { page++; apply(); });
      for (const link of grid.querySelectorAll(".reading-viewer")) {
        const url = new URL(link.href, window.location.href);
        url.searchParams.set("return", window.location.pathname + window.location.search);
        link.href = url.href;
      }
      apply();
      controls.hidden = false;
      pager.hidden = false;
    })();
  </script>
</Layout>
<style>
  .library-page { max-width: 72rem; margin-inline: auto; min-width: 0; }
  .library-page [hidden] { display: none !important; }
  h1 { font-size: 1.8rem; margin-bottom: 1rem; }
  h2 { font-size: 1.35rem; margin: 2rem 0 1rem; }
  .library-intro, .library-note { line-height: 1.85; max-width: 56rem; }
  .library-note { margin-top: 1rem; font-size: .9rem; }
  .learning-paths, .reading-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
  .learning-paths a, .reading-card { border: 1px solid #525252; border-radius: .8rem; padding: 1.1rem; min-width: 0; overflow-wrap: anywhere; }
  .learning-paths strong, .learning-paths span { display: block; }
  .learning-paths span { margin-top: .6rem; line-height: 1.7; font-size: .9rem; }
  .reading-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .reading-card { display: flex; flex-direction: column; gap: .8rem; }
  .reading-card h3 { font-size: 1.15rem; }
  .reading-summary { line-height: 1.8; }
  .reading-meta, .reading-tags { font-size: .8rem; }
  .reading-meta, .reading-links { display: flex; flex-wrap: wrap; gap: .6rem 1rem; }
  .reading-links { margin-top: auto; }
  .library-page a { text-underline-offset: .2em; }
  .reading-card a, .library-note a { text-decoration: underline; }
  .library-controls { display: grid; grid-template-columns: minmax(0, 24rem) minmax(0, 12rem); gap: 1rem; align-items: end; margin: 1rem 0; }
  .library-controls label { display: grid; grid-template-columns: minmax(0, 1fr); gap: .4rem; min-width: 0; }
  input, select, button { box-sizing: border-box; font: inherit; border: 1px solid #737373; border-radius: .4rem; padding: .55rem .8rem; background: #171717; color: #f5f5f5; max-width: 100%; }
  input, select { width: 100%; min-width: 0; }
  button:disabled { opacity: .45; }
  .library-pager { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin: 1rem 0; }
  :is(a, input, select, button):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media (max-width: 48rem) { .learning-paths, .reading-grid, .library-controls { grid-template-columns: minmax(0, 1fr); } }
</style>
