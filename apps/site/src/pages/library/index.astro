---
import { getLibraryItems } from "../../lib/libraryIndex";
import WorkPreview from "../../components/WorkPreview.astro";
import Layout from "../../layouts/Layout.astro";

const reservedTags = new Set(["m:top", "m:default", "m:__"]);
function displayTag(raw: unknown) {
  const tag = String(raw ?? "").trim();
  if (!tag || reservedTags.has(tag)) return "";
  const match = tag.match(/^(s|m|x):(.+)$/);
  return match ? (match[1] === "m" ? match[2] : "") : tag;
}
function dateText(value: unknown) {
  const text = String(value ?? "");
  return /^\d{4}-\d{2}-\d{2}/.test(text) ? text.slice(0, 10) : "";
}
function publishedDate(item: any) {
  return dateText(item.republished_at) || dateText(item.published_at) || dateText(item.created_at);
}
function viewerHref(value: string) {
  const url = new URL(value, "https://3dsl.jp");
  url.searchParams.set("return", "/library/");
  return url.origin === "https://3dsl.jp" ? url.pathname + url.search : url.href;
}
// All public cards exist in the initial HTML. JavaScript only filters these nodes.
const items = getLibraryItems().filter((item) => !item.hidden).map((item) => ({
  ...item,
  displayTags: (item.tags ?? []).map(displayTag).filter(Boolean),
  date: publishedDate(item),
})).sort((a, b) => b.date.localeCompare(a.date) || a.id.localeCompare(b.id));
---
<Layout title="作品を読む・作る | Library | 3DSL" description="3DSLの作品を解説と図で読む入口。「知識と問い」の読解、小作品の制作教材と、公開作品の一覧。">
  <section class="library-page">
    <h1>作品一覧</h1>
    <div id="library-controls" class="library-controls" hidden>
      <label>作品を探す<input class="ui-input" id="search" type="search" placeholder="作品名・説明・タグ・作品ID" aria-controls="cards" aria-describedby="library-search-help" /></label>
      <label>並べ替え<select class="ui-input" id="sort" aria-controls="cards"><option value="new">新しい順</option><option value="old">古い順</option><option value="title">名前順</option></select></label>
      <button class="ui-btn" id="clear-search" type="button" hidden>検索を解除</button>
      <p id="library-search-help" class="library-search-help">空白で区切ると、すべての語を含む作品に絞れます。全角・半角や英字の大小は区別しません。</p>
    </div>
    <section id="cards" class="reading-grid" aria-label="作品一覧">
      {items.map((item) => (
        <article class="reading-card" data-library-id={item.id} data-title={item.title} data-date={item.date} data-search={[item.id, item.title, item.summary ?? "", ...item.displayTags].join(" ")}>
          <a class="work-detail" href={typeof item.page === "string" ? item.page : `/library/${item.slug}/`}>
            {item.model_url && <WorkPreview model={item.model_url} />}
            <h2 class="site-work-title mt-2">{item.title}</h2>
          </a>
          <a class="site-link reading-viewer" href={viewerHref(item.viewer_url)}>Viewerで大きく開く</a>
        </article>
      ))}
    </section>
    {items.length === 0 && <p>現在、一覧に掲載する作品はありません。下の読解・制作教材から始められます。</p>}
    <p id="library-empty" role="status" hidden>一致する作品がありません。検索語を変えてください。</p>
    <nav id="library-pager" class="library-pager" aria-label="作品一覧のページ" hidden>
      <button class="ui-btn" id="prev" type="button">前へ</button><span id="page-info" role="status" aria-live="polite"></span><button class="ui-btn" id="next" type="button">次へ</button>
    </nav>
    <details class="work-guides mt-6"><summary>読解・制作の案内</summary>
      <p><a class="site-link" href="/docs/works/knowledge-questions/">知識と問いを読む</a> ／ <a class="site-link" href="/docs/usage/first-work/">はじめての一作品を作る</a></p>
    </details>
    <noscript><p>作品一覧はJavaScriptなしでも読めます。検索・並べ替え・ページ送りはJavaScriptを有効にすると利用できます。</p></noscript>
  </section>
  <script is:inline>
    (() => {
      const grid = document.getElementById("cards");
      const controls = document.getElementById("library-controls");
      const pager = document.getElementById("library-pager");
      const search = document.getElementById("search");
      const sort = document.getElementById("sort");
      const previous = document.getElementById("prev");
      const next = document.getElementById("next");
      const info = document.getElementById("page-info");
      const empty = document.getElementById("library-empty");
      const clearSearch = document.getElementById("clear-search");
      if (!grid || !controls || !pager || !search || !sort || !previous || !next || !info || !empty || !clearSearch) return;
      const cards = Array.from(grid.querySelectorAll("[data-library-id]"));
      const pageSize = 20;
      const initial = new URL(window.location.href).searchParams;
      search.value = initial.get("q") ?? "";
      sort.value = ["old", "title"].includes(initial.get("sort")) ? initial.get("sort") : "new";
      const requestedPage = Number(initial.get("page"));
      let page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
      const fold = value => String(value ?? "").normalize("NFKC").toLowerCase();
      function apply() {
        const words = fold(search.value).trim().split(/\s+/u).filter(Boolean);
        const selected = cards.filter((card) => {
          const text = fold(card.dataset.search);
          return words.every(word => text.includes(word));
        });
        selected.sort((a, b) => {
          if (sort.value === "title") return a.dataset.title.localeCompare(b.dataset.title, "ja");
          const byDate = a.dataset.date.localeCompare(b.dataset.date);
          return (sort.value === "old" ? byDate : -byDate) || a.dataset.libraryId.localeCompare(b.dataset.libraryId);
        });
        const pages = Math.max(1, Math.ceil(selected.length / pageSize));
        page = Math.max(1, Math.min(page, pages));
        for (const card of cards) card.hidden = true;
        for (const card of selected) grid.appendChild(card);
        for (const card of selected.slice((page - 1) * pageSize, page * pageSize)) card.hidden = false;
        info.textContent = pages === 1 ? `${selected.length}作品` : `${selected.length}作品・${page} / ${pages}ページ`;
        empty.hidden = selected.length !== 0;
        clearSearch.hidden = search.value.length === 0;
        previous.hidden = next.hidden = pages === 1;
        previous.disabled = page <= 1;
        next.disabled = page >= pages;
      }
      function listAddress(scroll) {
        const url = new URL(window.location.pathname, window.location.href);
        for (const [key, value] of [
          ["q", search.value], ["sort", sort.value === "new" ? "" : sort.value],
          ["page", page > 1 ? String(page) : ""], ["scroll", scroll > 0 ? String(Math.round(scroll)) : ""],
        ]) {
          if (value) url.searchParams.set(key, value);
        }
        return url;
      }
      function remember(list) {
        const url = new URL(window.location.href);
        for (const key of ["q", "sort", "page", "scroll"]) {
          if (list.searchParams.has(key)) url.searchParams.set(key, list.searchParams.get(key));
          else url.searchParams.delete(key);
        }
        if (url.href !== window.location.href) window.history.replaceState(window.history.state, "", url);
      }
      function update() {
        apply();
        remember(listAddress(0));
      }
      search.addEventListener("input", () => { page = 1; update(); });
      clearSearch.addEventListener("click", () => { search.value = ""; page = 1; update(); search.focus(); });
      sort.addEventListener("change", () => { page = 1; update(); });
      previous.addEventListener("click", () => { page--; update(); });
      next.addEventListener("click", () => { page++; update(); });

      function setReturnAddress(event) {
        const link = event.target.closest("a.work-detail, a.reading-viewer");
        if (!link) return;
        const from = listAddress(window.scrollY);
        remember(from);
        const destination = new URL(link.href);
        if (link.classList.contains("reading-viewer")) {
          destination.searchParams.set("return", from.pathname + from.search);
        } else if (destination.origin === from.origin) {
          if (from.search) destination.searchParams.set("list", from.search.slice(1));
          else destination.searchParams.delete("list");
        }
        link.href = destination.href;
      }
      for (const event of ["click", "auxclick", "contextmenu"]) {
        grid.addEventListener(event, setReturnAddress);
      }
      apply();
      controls.hidden = false;
      pager.hidden = false;
      window.addEventListener("pageshow", () => {
        const address = new URL(window.location.href);
        const scroll = Number(address.searchParams.get("scroll"));
        if (!address.hash && Number.isFinite(scroll) && scroll > 0) window.scrollTo(0, scroll);
      });
    })();
  </script>
</Layout>
<style>
  .library-page { max-width: 72rem; margin-inline: auto; min-width: 0; }
  .library-page [hidden] { display: none !important; }
  h1 { margin-bottom: 1rem; }
  .reading-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); gap: 1rem; }
  .reading-card { display: flex; flex-direction: column; gap: .8rem; padding: 1rem; min-width: 0; overflow-wrap: anywhere; background: var(--ui-surface); border: 1px solid var(--ui-border-2); border-radius: var(--ui-radius-lg); }
  .reading-viewer { align-self: start; font-size: .9rem; }
  .library-controls { display: grid; grid-template-columns: minmax(0, 24rem) minmax(0, 12rem) max-content; gap: 1rem; align-items: end; margin: 1rem 0; }
  .library-search-help { grid-column: 1 / -1; font-size: .85rem; line-height: 1.7; }
  .library-controls label { display: grid; grid-template-columns: minmax(0, 1fr); gap: .4rem; min-width: 0; }
  .library-pager { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin: 1rem 0; }
  @media (max-width: 48rem) { .library-controls { grid-template-columns: minmax(0, 1fr); } }
</style>
