---
import Layout from "../../layouts/Layout.astro";
import ConceptText from "../../content/pages/concept.md";
import AdSlot from "../../components/AdSlot.astro";
import { ADSENSE_SLOTS, shouldEnableAdsense } from "../../lib/adsense";

const eligiblePage = shouldEnableAdsense(Astro.url.pathname);
---

<Layout
  title="3DSLの狙い｜図と文章を往復し、知を共有する"
  description="言語化だけでは取り落とされる構造を、関係の図として保持し、拡大縮小しながら理解を往復させるという 3DSL の考え方を説明します。"
>
  <article class="concept-text prose prose-invert prose-neutral max-w-3xl">
    <ConceptText />
  </article>
  {eligiblePage && ADSENSE_SLOTS.slot_300x250 && (
    <aside class="mt-8" aria-label="広告">
      <span class="text-xs">広告</span>
      <AdSlot slot={ADSENSE_SLOTS.slot_300x250} width={300} height={250} waitForLibrary />
    </aside>
  )}
</Layout>
<style>
  .concept-text :global(p) { font-family: var(--font-title); }
  aside:not(:has(:global([data-3dsl-ad-reserved]))) { margin-top: 0; }
  aside:not(:has(:global([data-3dsl-ad-reserved]))) > span { display: none; }
</style>
