---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const faqs = (await getCollection("faq")).sort((a, b) => a.slug.localeCompare(b.slug, "ja"));
const title = "よくある質問 | FAQ | 3DSL";
const description = "3DSLの目的、作品の作成者と出典、利用条件、お問い合わせについてのよくある質問。";
---
<Layout title={title} description={description}>
  <h1 class="text-2xl font-medium tracking-tight">よくある質問</h1>
  <p class="mt-2 text-neutral-300 max-w-3xl">
    3DSLの目的、作品の作成者・出典、利用条件、お問い合わせについてのよくある質問をまとめています。
    図の読み方と操作手順は<a class="underline" href="/docs/">使い方と資料</a>から確認できます。
  </p>
  {faqs.length ? (
    <ul class="mt-6 grid gap-3 max-w-3xl">
      {faqs.map((e) => (
        <li class="rounded-2xl border border-white/10 bg-white/5 p-4 hover:bg-white/10">
          <a class="font-medium hover:underline" href={`/faq/${e.slug}/`}>{e.data?.title ?? e.slug}</a>
          {e.data?.summary && <p class="mt-2 text-sm text-neutral-300">{e.data.summary}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-6 text-sm text-neutral-400">質問が見つからない場合は<a href="/contact/">お問い合わせ</a>をご利用ください。</p>
  )}
</Layout>
