{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["astro/client", "node"],
    "moduleResolution": "Bundler",
    "module": "ESNext"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.astro",
    ".astro/types.d.ts",
    "astro.config.mjs"
  ],
  "exclude": [
    "src/works/meta-atlas/**/atlas.js",
    "public/**",
    "dist/**",
    "node_modules/**",
    "scripts/**"
  ]
}
